# Server
PORT=3001
NODE_ENV=development

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EMBEDDING_MODEL=llama3-8b-8192

# FAISS
FAISS_INDEX_PATH=./data/faiss_index
FAISS_DIMENSION=384

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Agent Settings
MAX_ITERATIONS=5
VALIDATOR_THRESHOLD=0.75
ENABLE_RE_RETRIEVAL=true

# CORS
FRONTEND_URL=http://localhost:5173
